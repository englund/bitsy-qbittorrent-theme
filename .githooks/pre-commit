#!/bin/sh
staged=$(git diff --cached --name-only)
echo "$staged" | grep -qE '^(www/|mock-server\.mjs|icons\.mjs)' || exit 0
echo "$staged" | grep -qx 'HANDOFF.md' && exit 0
echo "pre-commit: this commit changes the theme or the mock but not HANDOFF.md." >&2
echo "Record the change in HANDOFF.md in the same commit, or use --no-verify if it really needs no note." >&2
exit 1
